<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="order-flow" name="Order Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Order Creation Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="400" height="40" as="geometry"/>
        </mxCell>

        <!-- Start -->
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22c55e;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="500" y="70" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- User Actions -->
        <mxCell id="add-cart" value="Add to Cart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0ea5e9;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="checkout" value="Checkout&#xa;Preview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0ea5e9;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="480" y="220" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="select-addr" value="Select&#xa;Shipping Address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0ea5e9;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="300" y="300" width="100" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="select-pay" value="Select&#xa;Payment Method" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0ea5e9;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="540" y="300" width="100" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="apply-voucher" value="Apply&#xa;Voucher (Optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8b5cf6;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="780" y="300" width="100" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="confirm" value="Confirm&#xa;Checkout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f59e0b;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="380" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- Backend Process -->
        <mxCell id="validate" value="Validate Cart&#xa;&amp; Reserve Stock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748b;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="480" y="460" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="create-order" value="Create Order&#xa;&amp; SellerOrders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748b;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="480" y="540" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="create-payment" value="Create Payment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748b;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="480" y="620" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- Payment Gateway -->
        <mxCell id="payment-gw" value="Payment Gateway&#xa;(PayOS)" style="shape=hexagon;perimeter=hexagonPerimeter;whiteSpace=wrap;html=1;fillColor=#f59e0b;strokeColor=#d97706;" vertex="1" parent="1">
          <mxGeometry x="460" y="700" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Decision: Payment -->
        <mxCell id="pay-success" value="Payment&#xa;Success?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f97316;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="500" y="790" width="80" height="60" as="geometry"/>
        </mxCell>

        <!-- Success Path -->
        <mxCell id="grant-access" value="Grant Book Access&#xa;(Digital)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#22c55e;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="280" y="790" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="notify-seller" value="Notify Sellers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#22c55e;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="280" y="860" width="120" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="notify-user" value="Notify User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#22c55e;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="480" y="880" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- Failure Path -->
        <mxCell id="release-stock" value="Release Stock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ef4444;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="680" y="790" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="cancel-order" value="Cancel Order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ef4444;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="680" y="860" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#22c55e;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="500" y="940" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- Connections -->
        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="start" target="add-cart">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="add-cart" target="checkout">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="checkout" target="select-addr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="checkout" target="select-pay">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="checkout" target="apply-voucher">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="select-addr" target="confirm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="select-pay" target="confirm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="apply-voucher" target="confirm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="confirm" target="validate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="validate" target="create-order">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="create-order" target="create-payment">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="create-payment" target="payment-gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="payment-gw" target="pay-success">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce14" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="pay-success" target="grant-access">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="grant-access" target="notify-seller">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="notify-seller" target="notify-user">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="notify-user" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce18" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="pay-success" target="release-stock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="release-stock" target="cancel-order">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="cancel-order" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
