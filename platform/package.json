{
  "name": "@huki/platform",
  "version": "1.0.0",
  "description": "HUKI EBOOK - Backend Microservices",
  "private": true,
  "scripts": {
    "build": "npm run build:shared && npm run build:gateway && npm run build:identity && npm run build:business && npm run build:commerce && npm run build:shipping && npm run build:community && npm run build:promotion",
    "build:all": "npm run build",
    "build:shared": "tsc -p libs/shared/tsconfig.lib.json",
    "build:gateway": "tsc -p apps/api-gateway/tsconfig.app.json",
    "build:identity": "tsc -p apps/identity-service/tsconfig.app.json",
    "build:business": "tsc -p apps/business-service/tsconfig.app.json",
    "build:commerce": "tsc -p apps/commerce-service/tsconfig.app.json",
    "build:shipping": "tsc -p apps/shipping-service/tsconfig.app.json",
    "build:community": "tsc -p apps/community-service/tsconfig.app.json",
    "build:promotion": "tsc -p apps/promotion-service/tsconfig.app.json",
    "start": "node dist/out-tsc/api-gateway/apps/api-gateway/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/out-tsc/api-gateway/apps/api-gateway/src/main.js",
    "start:all": "node dist/out-tsc/api-gateway/apps/api-gateway/src/main.js & node dist/out-tsc/identity-service/apps/identity-service/src/main.js & node dist/out-tsc/business-service/apps/business-service/src/main.js & node dist/out-tsc/commerce-service/apps/commerce-service/src/main.js & node dist/out-tsc/shipping-service/apps/shipping-service/src/main.js & node dist/out-tsc/community-service/apps/community-service/src/main.js & node dist/out-tsc/promotion-service/apps/promotion-service/src/main.js",
    "start:identity": "node dist/out-tsc/identity-service/apps/identity-service/src/main.js",
    "start:business": "node dist/out-tsc/business-service/apps/business-service/src/main.js",
    "start:commerce": "node dist/out-tsc/commerce-service/apps/commerce-service/src/main.js",
    "start:shipping": "node dist/out-tsc/shipping-service/apps/shipping-service/src/main.js",
    "start:community": "node dist/out-tsc/community-service/apps/community-service/src/main.js",
    "start:promotion": "node dist/out-tsc/promotion-service/apps/promotion-service/src/main.js",
    "start:gateway": "node dist/out-tsc/api-gateway/apps/api-gateway/src/main.js",
    "dev": "concurrently -n GATEWAY,IDENTITY,BUSINESS,COMMERCE,SHIPPING,COMMUNITY,PROMOTION -c blue,green,yellow,magenta,cyan,red,gray \"npm run dev:gateway\" \"npm run dev:identity\" \"npm run dev:business\" \"npm run dev:commerce\" \"npm run dev:shipping\" \"npm run dev:community\" \"npm run dev:promotion\"",
    "dev:gateway": "cd apps/api-gateway && nodemon",
    "dev:identity": "cd apps/identity-service && nodemon",
    "dev:business": "cd apps/business-service && nodemon",
    "dev:commerce": "cd apps/commerce-service && nodemon",
    "dev:shipping": "cd apps/shipping-service && nodemon",
    "dev:community": "cd apps/community-service && nodemon",
    "dev:promotion": "cd apps/promotion-service && nodemon",
    "lint": "eslint apps/**/*.ts libs/**/*.ts --ext .ts",
    "test": "jest",
    "test:all": "jest",
    "test:gateway": "jest --config apps/api-gateway/jest.config.js",
    "test:contract": "jest --config libs/shared/jest.config.js",
    "test:identity": "jest --config apps/identity-service/jest.config.js",
    "test:business": "jest --config apps/business-service/jest.config.js",
    "test:commerce": "jest --config apps/commerce-service/jest.config.js",
    "test:shipping": "jest --config apps/shipping-service/jest.config.js",
    "test:community": "jest --config apps/community-service/jest.config.js",
    "test:promotion": "jest --config apps/promotion-service/jest.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:cov": "jest --coverage",
    "openapi:sync": "node scripts/sync-openapi.mjs",
    "openapi:check": "node scripts/sync-openapi.mjs --check",
    "prisma:generate": "npm run prisma:generate:identity && npm run prisma:generate:business && npm run prisma:generate:commerce && npm run prisma:generate:shipping && npm run prisma:generate:promotion",
    "prisma:generate:identity": "prisma generate --schema apps/identity-service/prisma/schema.prisma",
    "prisma:generate:business": "prisma generate --schema apps/business-service/prisma/schema.prisma",
    "prisma:generate:commerce": "prisma generate --schema apps/commerce-service/prisma/schema.prisma",
    "prisma:generate:shipping": "prisma generate --schema apps/shipping-service/prisma/schema.prisma",
    "prisma:generate:promotion": "prisma generate --schema apps/promotion-service/prisma/schema.prisma",
    "prisma:migrate:dev": "npm run prisma:migrate:dev:identity && npm run prisma:migrate:dev:business && npm run prisma:migrate:dev:commerce && npm run prisma:migrate:dev:shipping && npm run prisma:migrate:dev:promotion",
    "prisma:migrate:dev:identity": "prisma migrate dev --schema apps/identity-service/prisma/schema.prisma --name platform_dev",
    "prisma:migrate:dev:business": "prisma migrate dev --schema apps/business-service/prisma/schema.prisma --name platform_dev",
    "prisma:migrate:dev:commerce": "prisma migrate dev --schema apps/commerce-service/prisma/schema.prisma --name platform_dev",
    "prisma:migrate:dev:shipping": "prisma migrate dev --schema apps/shipping-service/prisma/schema.prisma --name platform_dev",
    "prisma:migrate:dev:promotion": "prisma migrate dev --schema apps/promotion-service/prisma/schema.prisma --name platform_dev",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy:identity && npm run prisma:migrate:deploy:business && npm run prisma:migrate:deploy:commerce && npm run prisma:migrate:deploy:shipping && npm run prisma:migrate:deploy:promotion",
    "prisma:migrate:deploy:identity": "prisma migrate deploy --schema apps/identity-service/prisma/schema.prisma",
    "prisma:migrate:deploy:business": "prisma migrate deploy --schema apps/business-service/prisma/schema.prisma",
    "prisma:migrate:deploy:commerce": "prisma migrate deploy --schema apps/commerce-service/prisma/schema.prisma",
    "prisma:migrate:deploy:shipping": "prisma migrate deploy --schema apps/shipping-service/prisma/schema.prisma",
    "prisma:migrate:deploy:promotion": "prisma migrate deploy --schema apps/promotion-service/prisma/schema.prisma",
    "prisma:migrate:reset": "npm run prisma:migrate:reset:identity && npm run prisma:migrate:reset:business && npm run prisma:migrate:reset:commerce && npm run prisma:migrate:reset:shipping && npm run prisma:migrate:reset:promotion",
    "prisma:migrate:reset:identity": "prisma migrate reset --schema apps/identity-service/prisma/schema.prisma --force",
    "prisma:migrate:reset:business": "prisma migrate reset --schema apps/business-service/prisma/schema.prisma --force",
    "prisma:migrate:reset:commerce": "prisma migrate reset --schema apps/commerce-service/prisma/schema.prisma --force",
    "prisma:migrate:reset:shipping": "prisma migrate reset --schema apps/shipping-service/prisma/schema.prisma --force",
    "prisma:migrate:reset:promotion": "prisma migrate reset --schema apps/promotion-service/prisma/schema.prisma --force",
    "local:infra": "docker compose -f ../docker-compose.yml up -d postgres mongo redis rabbitmq",
    "local:setup": "npm run local:infra && sleep 5 && npm run prisma:generate && npm run build && npm run prisma:migrate:deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@nestjs/bull": "^10.0.1",
    "@nestjs/cache-manager": "^2.1.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.0.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/mongoose": "^10.0.2",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^5.1.1",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "5.22.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.3",
    "bcrypt": "^5.1.1",
    "cache-manager-ioredis-yet": "^1.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.5",
    "firebase-admin": "^13.4.0",
    "ioredis": "^5.3.2",
    "mongoose": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "prisma": "5.22.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "nx": "^17.3.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.3.3"
  },
  "nx": {
    "includedScripts": []
  },
  "jest": {
    "projects": [
      "apps/api-gateway/jest.config.js",
      "apps/identity-service/jest.config.js",
      "apps/business-service/jest.config.js",
      "apps/commerce-service/jest.config.js",
      "apps/shipping-service/jest.config.js",
      "apps/community-service/jest.config.js",
      "apps/promotion-service/jest.config.js",
      "libs/shared/jest.config.js"
    ]
  }
}
