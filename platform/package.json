{
  "name": "@huki/platform",
  "version": "1.0.0",
  "description": "HUKI EBOOK - Backend Microservices",
  "private": true,
  "scripts": {
    "build": "nest build",
    "build:all": "nx run-many -t build",
    "build:commerce": "nest build commerce-service",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:all": "nx run-many -t serve",
    "start:identity": "nx serve identity-service",
    "start:business": "nx serve business-service",
    "start:commerce": "nest start commerce-service --watch",
    "start:shipping": "nx serve shipping-service",
    "start:community": "nx serve community-service",
    "start:promotion": "nx serve promotion-service",
    "start:gateway": "nx serve api-gateway",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:commerce": "jest --config apps/commerce-service/jest.config.js",
    "test:cov": "nx run-many -t test --coverage",
    "migration:commerce:run": "typeorm-ts-node-commonjs migration:run -d apps/commerce-service/src/database/data-source.ts",
    "migration:commerce:revert": "typeorm-ts-node-commonjs migration:revert -d apps/commerce-service/src/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/typeorm": "^10.0.1",
    "@nestjs/mongoose": "^10.0.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/bull": "^10.0.1",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^5.1.1",
    "@nestjs/event-emitter": "^2.0.3",
    "@nestjs/cache-manager": "^2.1.1",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.3",
    "typeorm": "^0.3.19",
    "pg": "^8.11.3",
    "mongoose": "^8.1.0",
    "ioredis": "^5.3.2",
    "cache-manager-ioredis-yet": "^1.2.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "bcrypt": "^5.1.1",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "rxjs": "^7.8.1",
    "reflect-metadata": "^0.2.1",
    "uuid": "^9.0.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/node": "^20.11.0",
    "@types/express": "^4.17.21",
    "@types/bcrypt": "^5.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "nx": "^17.3.0"
  },
  "nx": {
    "includedScripts": []
  }
}
