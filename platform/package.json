{
  "name": "@huki/platform",
  "version": "1.0.0",
  "description": "HUKI EBOOK - Backend Microservices",
  "private": true,
  "scripts": {
    "build": "nest build",
    "build:all": "nx run-many -t build",
    "build:commerce": "nest build commerce-service",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:all": "nx run-many -t serve",
    "start:identity": "nx serve identity-service",
    "start:business": "nx serve business-service",
    "start:commerce": "nest start commerce-service --watch",
    "start:shipping": "nest start shipping-service --watch",
    "start:community": "nest start community-service --watch",
    "start:promotion": "nx serve promotion-service",
    "start:gateway": "nx serve api-gateway",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:commerce": "jest --config apps/commerce-service/jest.config.js",
    "test:shipping": "jest --config apps/shipping-service/jest.config.js",
    "test:cov": "nx run-many -t test --coverage",
    "prisma:generate": "npm run prisma:generate:identity && npm run prisma:generate:business && npm run prisma:generate:commerce && npm run prisma:generate:shipping && npm run prisma:generate:promotion",
    "prisma:generate:identity": "prisma generate --schema apps/identity-service/prisma/schema.prisma",
    "prisma:generate:business": "prisma generate --schema apps/business-service/prisma/schema.prisma",
    "prisma:generate:commerce": "prisma generate --schema apps/commerce-service/prisma/schema.prisma",
    "prisma:generate:shipping": "prisma generate --schema apps/shipping-service/prisma/schema.prisma",
    "prisma:generate:promotion": "prisma generate --schema apps/promotion-service/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema apps/identity-service/prisma/schema.prisma && prisma migrate deploy --schema apps/business-service/prisma/schema.prisma && prisma migrate deploy --schema apps/commerce-service/prisma/schema.prisma && prisma migrate deploy --schema apps/shipping-service/prisma/schema.prisma && prisma migrate deploy --schema apps/promotion-service/prisma/schema.prisma",
    "local:infra": "docker compose -f ../docker-compose.yml up -d postgres mongo redis rabbitmq",
    "local:migrate:phase3": "prisma migrate deploy --schema apps/commerce-service/prisma/schema.prisma && prisma migrate deploy --schema apps/shipping-service/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@nestjs/bull": "^10.0.1",
    "@nestjs/cache-manager": "^2.1.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.0.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/mongoose": "^10.0.2",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^5.1.1",
    "@prisma/client": "5.22.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.3",
    "bcrypt": "^5.1.1",
    "cache-manager-ioredis-yet": "^1.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.3.2",
    "mongoose": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "prisma": "5.22.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nx": "^17.3.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "nx": {
    "includedScripts": []
  }
}
