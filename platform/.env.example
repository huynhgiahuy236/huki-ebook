# ============================================
# HUKI EBOOK - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# ============================================
# SERVICE PORTS
# ============================================
IDENTITY_SERVICE_PORT=3001
BUSINESS_SERVICE_PORT=3002
COMMERCE_SERVICE_PORT=3003
SHIPPING_SERVICE_PORT=3004
COMMUNITY_SERVICE_PORT=3005
PROMOTION_SERVICE_PORT=3007
API_GATEWAY_PORT=3000

# ============================================
# JWT CONFIGURATION (CRITICAL)
# ============================================
JWT_SECRET=change-this-to-a-very-long-random-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# BCRYPT
# ============================================
BCRYPT_ROUNDS=12

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# CORS (Comma-separated domains)
# ============================================
CORS_ORIGINS=http://localhost:3000,https://huki-ebook.com
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ============================================
# POSTGRESQL (Local Development)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
DATABASE_SYNC=false
DATABASE_LOGGING=true

IDENTITY_DB_NAME=identity_db
BUSINESS_DB_NAME=business_db
COMMERCE_DB_NAME=commerce_db
SHIPPING_DB_NAME=shipping_db
PROMOTION_DB_NAME=promotion_db

# Prisma requires one connection string per PostgreSQL service.
# URL-encode special characters in the username/password.
IDENTITY_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/identity_db?schema=public
BUSINESS_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/business_db?schema=public
COMMERCE_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/commerce_db?schema=public
SHIPPING_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/shipping_db?schema=public
PROMOTION_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/promotion_db?schema=public

# ============================================
# MONGODB (Local Development)
# ============================================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=community_db
MONGODB_URI=mongodb://localhost:27017/community_db

# ============================================
# REDIS (Local Development)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# RABBITMQ (Local Development)
# ============================================
RABBITMQ_URL=amqp://guest:guest123@localhost:5672

# ============================================
# CLOUDINARY
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# CLOUDFLARE R2
# ============================================
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=huki-ebooks
R2_PUBLIC_URL=https://your-public-url.r2.dev

# Commerce Service R2/S3-compatible configuration
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_R2_BUCKET=huki-ebooks
BOOK_COVER_MAX_BYTES=5242880
BOOK_PDF_MAX_BYTES=104857600
CHECKOUT_SESSION_TTL_MINUTES=15
CHECKOUT_SHIPPING_BASE_FEE=30000

# ============================================
# PAYOS
# ============================================
PAYOS_CLIENT_ID=your-client-id
PAYOS_API_KEY=your-api-key
PAYOS_CHECKSUM_KEY=your-checksum-key

# ============================================
# SENDGRID (Email)
# ============================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@huki-ebook.com

# ============================================
# FIREBASE (Push Notifications)
# ============================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# ============================================
# AWS (Production)
# ============================================
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
