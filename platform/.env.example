# ============================================
# HUKI EBOOK - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# ============================================
# SERVICE PORTS
# ============================================
IDENTITY_SERVICE_PORT=3001
BUSINESS_SERVICE_PORT=3002
COMMERCE_SERVICE_PORT=3003
SHIPPING_SERVICE_PORT=3004
COMMUNITY_SERVICE_PORT=3005
PROMOTION_SERVICE_PORT=3007
API_GATEWAY_PORT=3000

# Hosts used by the API Gateway when all services run on the same machine.
IDENTITY_SERVICE_HOST=localhost
BUSINESS_SERVICE_HOST=localhost
COMMERCE_SERVICE_HOST=localhost
SHIPPING_SERVICE_HOST=localhost
COMMUNITY_SERVICE_HOST=localhost
PROMOTION_SERVICE_HOST=localhost

# Internal URLs used for service-to-service calls and OpenAPI aggregation.
IDENTITY_SERVICE_URL=http://localhost:3001
BUSINESS_SERVICE_URL=http://localhost:3002
COMMERCE_SERVICE_URL=http://localhost:3003
SHIPPING_SERVICE_URL=http://localhost:3004
COMMUNITY_SERVICE_URL=http://localhost:3005
PROMOTION_SERVICE_URL=http://localhost:3007
INTERNAL_SERVICE_KEY=huki-local-internal-service

# ============================================
# JWT CONFIGURATION (CRITICAL)
# ============================================
JWT_SECRET=change-this-to-a-very-long-random-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# BCRYPT
# ============================================
BCRYPT_ROUNDS=12

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# CORS (Comma-separated domains)
# ============================================
CORS_ORIGINS=http://localhost:3100
CORS_ORIGIN=http://localhost:3100
SOCKET_CORS_ORIGIN=http://localhost:3100

# ============================================
# POSTGRESQL (Local Development)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
DATABASE_SYNC=false
DATABASE_LOGGING=true

IDENTITY_DB_NAME=huki_identity
BUSINESS_DB_NAME=huki_business
COMMERCE_DB_NAME=huki_commerce
SHIPPING_DB_NAME=huki_shipping
PROMOTION_DB_NAME=huki_promotion

# Prisma requires one connection string per PostgreSQL service.
# URL-encode special characters in the username/password.
IDENTITY_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/huki_identity?schema=public
BUSINESS_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/huki_business?schema=public
COMMERCE_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/huki_commerce?schema=public
SHIPPING_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/huki_shipping?schema=public
PROMOTION_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/huki_promotion?schema=public

# ============================================
# MONGODB (Local Development)
# ============================================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=community_db
MONGODB_URI=mongodb://localhost:27017/community_db

# ============================================
# REDIS (Local Development)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# RABBITMQ (Local Development)
# ============================================
RABBITMQ_URL=amqp://guest:guest123@localhost:5672
RABBITMQ_EXCHANGE=huki.events

# ============================================
# CLOUDINARY
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# CLOUDFLARE R2 (Commerce Service)
# ============================================
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_R2_BUCKET=huki-ebooks
BOOK_COVER_MAX_BYTES=5242880
BOOK_PDF_MAX_BYTES=104857600
CHECKOUT_SESSION_TTL_MINUTES=15
CHECKOUT_SHIPPING_BASE_FEE=30000

# ============================================
# SHIPPING / GHTK MOCK
# ============================================
SHIPPING_INTERNAL_API_KEY=replace-with-a-long-random-internal-key
SHIPPING_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
PROMOTION_INTERNAL_API_KEY=replace-with-a-long-random-internal-key
GHTK_PICKUP_PROVINCE=Hồ Chí Minh
GHTK_PICKUP_DISTRICT=Quận 1
GHTK_MOCK_BASE_FEE=15000
GHTK_MOCK_EXTRA_500G_FEE=5000
GHTK_MOCK_INTER_PROVINCE_FEE=10000
GHTK_MOCK_COD_RATE=0.005

# ============================================
# PAYOS
# ============================================
PAYOS_CLIENT_ID=your-client-id
PAYOS_API_KEY=your-api-key
PAYOS_CHECKSUM_KEY=your-checksum-key

# ============================================
# SENDGRID (Email)
# ============================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@huki-ebook.com
FRONTEND_URL=http://localhost:3100

# ============================================
# FIREBASE (Push Notifications)
# ============================================
# Placeholder/missing credentials keep FCM disabled for local development.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key-with-escaped-\n-line-breaks
FIREBASE_CLIENT_EMAIL=your-client-email

# ============================================
# AWS (Production)
# ============================================
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# ============================================
# POLICY & DECISION CONFIGURATION (DEC-001 -> DEC-008)
# CAUTION: Values below are ENGINEERING DEFAULTS / PLACEHOLDERS
# pending formal approval by Product Owner.
# ============================================
# DEC-001: Payment countdown timer TTL in seconds (Dev: 120, Prod proposed: 900)
ORDER_PAYMENT_TTL_SECONDS=120

# DEC-002: Platform commission percentage (Proposed: 15)
PLATFORM_COMMISSION_PERCENT=15

# DEC-002: Fee calculation basis: SUBTOTAL (Original price) vs NET_PAID (After shop discount)
COMMISSION_CALCULATION_BASIS=NET_PAID

# DEC-003: Electronic VAT Invoice mode: MANUAL vs E_INVOICE_API
VAT_INVOICE_MODE=MANUAL

# DEC-004: Platform voucher funding subsidy rate (1.0 = 100% platform funded)
PLATFORM_VOUCHER_SUBSIDY_RATE=1.0

# DEC-005: Feature flag for Huki Coin reward system (true/false)
FEATURE_COIN_ENABLED=false

# DEC-006: Merchant dispatch SLA deadline in hours (Proposed: 48)
MERCHANT_DISPATCH_DEADLINE_HOURS=48

# DEC-006: Auto-cancel sub-orders on dispatch timeout (true/false)
AUTO_CANCEL_ON_DISPATCH_TIMEOUT=false

# DEC-007: Maximum simultaneous active DRM reader devices per account (3 vs 5)
DRM_MAX_ACTIVE_DEVICES=3

# DEC-008: Shipping pricing model: FLAT_RATE vs THIRD_PARTY_API
SHIPPING_PRICING_MODEL=FLAT_RATE

