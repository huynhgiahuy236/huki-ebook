// Analytics Service - Prisma Schema
// Database: analytics_db

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("ANALYTICS_DATABASE_URL")
}

enum AggregateScope {
  PLATFORM
  STORE
  BOOK
}

model AnalyticsEvent {
  id            String   @id @default(uuid())
  sourceEventId String   @unique @map("source_event_id")
  eventType     String   @map("event_type") @db.VarChar(100)
  userId        String?  @map("user_id")
  sessionId     String?  @map("session_id")
  storeId       String?  @map("store_id")
  bookId        String?  @map("book_id")
  properties    Json?
  context       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([storeId, createdAt])
  @@index([bookId, createdAt])
  @@map("analytics_events")
}

model DomainFactSnapshot {
  id            String   @id @default(uuid())
  factId        String   @unique @map("fact_id")
  eventId       String   @map("event_id")
  eventType     String   @map("event_type") @db.VarChar(100)
  factType      String   @map("fact_type") @db.VarChar(100)
  orderId       String   @map("order_id")
  sellerOrderId String?  @map("seller_order_id")
  storeId       String?  @map("store_id")
  bookId        String?  @map("book_id")
  quantity      Int      @default(0)
  amount        Decimal  @default(0) @db.Decimal(15, 2)
  metadata      Json?
  occurredAt    DateTime @map("occurred_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([occurredAt, factType])
  @@index([storeId, occurredAt])
  @@index([bookId, occurredAt])
  @@map("domain_fact_snapshots")
}

model DailyAggregate {
  id           String         @id @default(uuid())
  businessDate DateTime       @map("business_date") @db.Date
  metricName   String         @map("metric_name") @db.VarChar(100)
  scope        AggregateScope @default(PLATFORM)
  dimensionKey String         @map("dimension_key") @db.VarChar(255)
  storeId      String?        @map("store_id")
  bookId       String?        @map("book_id")
  metricValue  Decimal        @map("metric_value") @db.Decimal(15, 2)
  dimensions   Json?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@unique([businessDate, metricName, scope, dimensionKey], name: "unique_daily_aggregate_grain")
  @@index([businessDate, scope])
  @@index([storeId, businessDate])
  @@index([bookId, businessDate])
  @@index([metricName, businessDate])
  @@map("daily_aggregates")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id")
  eventType   String   @map("event_type") @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}

// ============================================================================
// User Affinity Models - Gợi Ý Sách Cá Nhân Hóa
// ============================================================================

// Điểm sở thích theo thể loại sách của từng người dùng
// Tách riêng viewScore và purchaseScore để đánh giá chính xác hơn
model UserCategoryAffinity {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  categoryId          String   @map("category_id")
  viewScore           Decimal  @default(0) @map("view_score") @db.Decimal(10, 2)
  purchaseScore       Decimal  @default(0) @map("purchase_score") @db.Decimal(10, 2)
  totalAffinityScore  Decimal  @default(0) @map("total_affinity_score") @db.Decimal(10, 2)
  interactionCount    Int      @default(0) @map("interaction_count")
  lastInteractedAt    DateTime @default(now()) @map("last_interacted_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([userId, categoryId], name: "unique_user_category")
  @@index([userId, totalAffinityScore(sort: Desc)])
  @@index([categoryId])
  @@map("user_category_affinities")
}

// Điểm yêu thích theo tác giả của từng người dùng
model UserAuthorAffinity {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  authorId            String   @map("author_id")
  viewScore           Decimal  @default(0) @map("view_score") @db.Decimal(10, 2)
  purchaseScore       Decimal  @default(0) @map("purchase_score") @db.Decimal(10, 2)
  totalAffinityScore  Decimal  @default(0) @map("total_affinity_score") @db.Decimal(10, 2)
  interactionCount    Int      @default(0) @map("interaction_count")
  lastInteractedAt    DateTime @default(now()) @map("last_interacted_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([userId, authorId], name: "unique_user_author")
  @@index([userId, totalAffinityScore(sort: Desc)])
  @@index([authorId])
  @@map("user_author_affinities")
}
