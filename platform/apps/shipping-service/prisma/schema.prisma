// Shipping Service - Prisma Schema
// Database: shipping_db

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("SHIPPING_DATABASE_URL")
}

model Shipment {
  id             String  @id @default(uuid())
  orderId        String  @map("order_id")
  sellerOrderId  String  @unique @map("seller_order_id")
  userId         String  @map("user_id")
  storeId        String  @map("store_id")
  ownerUserId    String  @map("owner_user_id")
  trackingNumber String? @unique @map("tracking_number")
  carrier        String  @default("GHTK")
  paymentMethod  String  @map("payment_method")

  status ShipmentStatus @default(PENDING)

  // Address
  receiverName  String @map("receiver_name")
  receiverPhone String @map("receiver_phone")
  address       String
  province      String
  district      String
  ward          String

  // Fees
  shippingFee Decimal @map("shipping_fee") @db.Decimal(14, 2)
  codAmount   Decimal @default(0) @map("cod_amount") @db.Decimal(14, 2)
  codFee      Decimal @default(0) @map("cod_fee") @db.Decimal(14, 2)
  weight      Int

  // Timeline
  pickedUpAt          DateTime? @map("picked_up_at")
  shippedAt           DateTime? @map("shipped_at")
  deliveredAt         DateTime? @map("delivered_at")
  returnedAt          DateTime? @map("returned_at")
  cancelledAt         DateTime? @map("cancelled_at")
  estimatedDeliveryAt DateTime? @map("estimated_delivery_at")
  failedAttempts      Int       @default(0) @map("failed_attempts")

  assignedStaffId String?        @map("assigned_staff_id")
  assignedStaff   DeliveryStaff? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  logs            DeliveryLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([userId, createdAt])
  @@index([storeId, createdAt])
  @@index([ownerUserId, createdAt])
  @@index([assignedStaffId])
  @@index([status])
  @@index([trackingNumber])
  @@map("shipments")
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
  FAILED
}

model Address {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  name      String
  phone     String
  address   String
  province  String
  district  String
  ward      String
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("addresses")
}

model DeliveryStaff {
  id          String      @id @default(uuid())
  userId      String      @unique @map("user_id")
  name        String
  phone       String
  email       String?
  status      StaffStatus @default(ACTIVE)
  currentArea String?     @map("current_area")

  shipments Shipment[]
  logs      DeliveryLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("delivery_staff")
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model DeliveryLog {
  id              String         @id @default(uuid())
  shipmentId      String         @map("shipment_id")
  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  staffId         String?        @map("staff_id")
  staff           DeliveryStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  status          ShipmentStatus
  action          String
  source          LogSource      @default(SYSTEM)
  externalEventId String?        @unique @map("external_event_id")
  note            String?
  location        String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([shipmentId])
  @@index([staffId])
  @@map("delivery_logs")
}

enum LogSource {
  SYSTEM
  ADMIN
  STAFF
  CARRIER
}

model OutboxEvent {
  id          String       @id @default(uuid())
  eventId     String       @unique @map("event_id")
  type        String
  aggregateId String       @map("aggregate_id")
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  processedAt DateTime?    @map("processed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([aggregateId])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
