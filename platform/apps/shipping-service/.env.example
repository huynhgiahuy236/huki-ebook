# ============================================
# Shipping Service Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# ============================================
# SERVICE CONFIG
# ============================================
PORT=3004
NODE_ENV=development

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
DATABASE_NAME=huki_shipping
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/shipping_db?schema=public

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=change-this-to-a-very-long-random-string-in-production
JWT_ACCESS_SECRET=change-this-to-a-very-long-random-string-in-production

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ============================================
# REDIS (Caching)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# INTERNAL API (Commerce Service)
# ============================================
COMMERCE_SERVICE_URL=http://localhost:3003
INTERNAL_API_KEY=replace-with-a-long-random-internal-key

# ============================================
# GHTK MOCK CONFIGURATION
# ============================================
GHTK_MOCK_ENABLED=true
GHTK_PICKUP_PROVINCE=Hồ Chí Minh
GHTK_PICKUP_DISTRICT=Quận 1
GHTK_PICKUP_ADDRESS=123 Đường Test, Quận 1
GHTK_PICKUP_WARD=Phường 1
GHTK_PICKUP_TELEPHONE=0912345678
GHTK_PICKUP_NAME=Cửa hàng HUKI

# Mock fees (VND)
GHTK_MOCK_BASE_FEE=15000
GHTK_MOCK_EXTRA_500G_FEE=5000
GHTK_MOCK_INTER_PROVINCE_FEE=10000
GHTK_MOCK_COD_RATE=0.005

# ============================================
# GHTK PRODUCTION (when GHTK_MOCK_ENABLED=false)
# ============================================
GHTK_API_URL=https://dev.viettranscode.com/api
GHTK_API_TOKEN=your-ghtk-api-token
GHTK_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# ============================================
# SHIPPING INTERNAL API
# ============================================
SHIPPING_INTERNAL_API_KEY=replace-with-a-long-random-internal-key

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
