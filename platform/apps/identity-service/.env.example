# ============================================
# Identity Service Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# ============================================
# SERVICE CONFIG
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
DATABASE_NAME=huki_identity
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/identity_db?schema=public

# ============================================
# JWT CONFIGURATION (CRITICAL)
# ============================================
JWT_SECRET=change-this-to-a-very-long-random-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_SECRET=change-this-to-a-very-long-random-string-in-production
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string-in-production

# ============================================
# BCRYPT
# ============================================
BCRYPT_ROUNDS=12

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ============================================
# SENDGRID (Email Verification)
# ============================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@huki-ebook.com
SENDGRID_WELCOME_TEMPLATE_ID=your-template-id
SENDGRID_VERIFY_TEMPLATE_ID=your-template-id

# ============================================
# REDIS (Session Storage)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=3
