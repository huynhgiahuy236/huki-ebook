# ============================================
# Community Service Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# ============================================
# SERVICE CONFIG
# ============================================
PORT=3005
NODE_ENV=development

# ============================================
# DATABASE (MongoDB)
# ============================================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=huki_community
MONGODB_URI=mongodb://localhost:27017/community_db

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=change-this-to-a-very-long-random-string-in-production
JWT_ACCESS_SECRET=change-this-to-a-very-long-random-string-in-production

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ============================================
# REDIS (Caching & Pub/Sub)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# FIREBASE (Push Notifications)
# ============================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key-with-escaped-\n-line-breaks
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_ENABLED=false

# ============================================
# BUSINESS SERVICE (Internal API)
# ============================================
BUSINESS_SERVICE_URL=http://localhost:3002
INTERNAL_API_KEY=replace-with-a-long-random-internal-key

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# CHAT SETTINGS
# ============================================
CHAT_MAX_MESSAGE_LENGTH=1000
CHAT_MAX_CONVERSATION_PARTICIPANTS=50

# ============================================
# REVIEW SETTINGS
# ============================================
REVIEW_MAX_LENGTH=2000
REVIEW_MIN_PURCHASE_REQUIRED=true
