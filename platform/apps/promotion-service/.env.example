# ============================================
# Promotion Service Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# ============================================
# SERVICE CONFIG
# ============================================
PORT=3007
NODE_ENV=development

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
DATABASE_NAME=huki_promotion
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/promotion_db?schema=public

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=change-this-to-a-very-long-random-string-in-production
JWT_ACCESS_SECRET=change-this-to-a-very-long-random-string-in-production

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ============================================
# REDIS (Caching)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# INTERNAL API (Commerce Service)
# ============================================
COMMERCE_SERVICE_URL=http://localhost:3003
INTERNAL_API_KEY=replace-with-a-long-random-internal-key

# ============================================
# VOUCHER SETTINGS
# ============================================
VOUCHER_CODE_LENGTH=8
VOUCHER_MAX_USAGE_PER_USER=1
VOUCHER_MIN_ORDER_AMOUNT=0

# ============================================
# FLASH SALE SETTINGS
# ============================================
FLASH_SALE_MAX_ITEMS_PER_USER=1
FLASH_SALE_STOCK_RESERVATION_TTL_MINUTES=15

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
