// Promotion Service - Prisma Schema
// Database: promotion_db

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("PROMOTION_DATABASE_URL")
}

// ============================================
// VOUCHERS
// ============================================

model Voucher {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  // Type & Value
  type  VoucherType
  value Float

  // Conditions
  minOrderAmount    Float  @default(0) @map("min_order_amount")
  maxDiscountAmount Float? @map("max_discount_amount")

  // Scope
  scope   VoucherScope @default(PLATFORM)
  storeId String?      @map("store_id")

  // Limits
  totalUsage      Int  @default(0) @map("total_usage")
  maxUsagePerUser Int? @map("max_usage_per_user")
  currentUsage    Int  @default(0) @map("current_usage")

  // Validity
  startsAt  DateTime @map("starts_at")
  expiresAt DateTime @map("expires_at")

  status VoucherStatus @default(ACTIVE)

  // Target Audience & Loyalty Tier
  targetAudience VoucherTargetAudience @default(ALL) @map("target_audience")
  minFollowDays  Int?                  @default(0) @map("min_follow_days")

  // Relations
  usages VoucherUsage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@index([status])
  @@index([expiresAt])
  @@index([targetAudience])
  @@map("vouchers")
}

enum VoucherType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum VoucherScope {
  PLATFORM
  STORE
}

enum VoucherTargetAudience {
  ALL
  FOLLOWERS_ONLY
  NEW_CUSTOMERS_ONLY
}

enum VoucherStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  USED_UP
}

model VoucherUsage {
  id        String  @id @default(uuid())
  voucherId String  @map("voucher_id")
  voucher   Voucher @relation(fields: [voucherId], references: [id])
  userId    String  @map("user_id")
  orderId   String  @map("order_id")
  discount  Float

  createdAt DateTime @default(now()) @map("created_at")

  @@index([voucherId])
  @@index([userId])
  @@map("voucher_usages")
}

// ============================================
// BANNERS
// ============================================

model Banner {
  id        String    @id @default(uuid())
  title     String
  image     String
  link      String?
  position  Int       @default(0)
  isActive  Boolean   @default(true) @map("is_active")
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  // Scope
  scope   BannerScope @default(HOMEPAGE)
  storeId String?     @map("store_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

enum BannerScope {
  HOMEPAGE
  CATEGORY
  STORE
}

// ============================================
// BOOK DISCOUNTS
// ============================================

model BookDiscount {
  id     String       @id @default(uuid())
  bookId String       @map("book_id")
  type   DiscountType
  value  Float

  // Conditions
  minQuantity Int? @map("min_quantity")

  // Validity
  startsAt  DateTime @map("starts_at")
  expiresAt DateTime @map("expires_at")

  status DiscountStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([bookId])
  @@index([expiresAt])
  @@map("book_discounts")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ============================================
// FLASH SALE
// ============================================

enum FlashSaleScope {
  PLATFORM
  SHOP
}

model FlashSale {
  id          String         @id @default(uuid())
  name        String
  description String?
  bannerUrl   String?        @map("banner_url")

  // Scope & Ownership
  scope       FlashSaleScope @default(PLATFORM)
  storeId     String?        @map("store_id")

  // Timeline 4 mốc cho Platform Flash Sale (Nullable để tương thích Shop Flash Sale)
  registrationStartsAt DateTime?      @map("registration_starts_at")
  registrationEndsAt   DateTime?      @map("registration_ends_at")
  startsAt             DateTime       @map("starts_at")
  endsAt               DateTime       @map("ends_at")

  // Giới hạn số lượng Shop tham gia (Dành cho Platform Flash Sale)
  minStores            Int            @default(1) @map("min_stores")
  maxStores            Int            @default(10) @map("max_stores")

  // Cấu hình trợ giá và giới hạn mua toàn sàn
  discountPercent      Float?         @default(30) @map("discount_percent")
  maxPerUser           Int?           @default(1) @map("max_per_user")

  status               FlashSaleStatus @default(SCHEDULED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items FlashSaleItem[]

  @@index([scope, status])
  @@index([storeId, status])
  @@map("flash_sales")
}

enum FlashSaleStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

model FlashSaleItem {
  id          String  @id @default(uuid())
  flashSaleId String  @map("flash_sale_id")
  bookId      String  @map("book_id")
  storeId     String? @map("store_id")

  originalPrice Float @map("original_price")
  salePrice     Float @map("sale_price")

  // Limits
  stock      Int
  sold       Int @default(0)
  maxPerUser Int @default(1) @map("max_per_user")

  createdAt DateTime @default(now()) @map("created_at")

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id])

  @@index([flashSaleId])
  @@index([bookId])
  @@index([storeId])
  @@map("flash_sale_items")
}

// ============================================
// OUTBOX (Event Sourcing)
// ============================================

model OutboxEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique @map("event_id")
  type        String
  aggregateId String    @map("aggregate_id")
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

// ============================================
// GOVERNANCE AUDIT LOGS (Phase 1)
// ============================================

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String   @map("actor_id")
  actorRole     String?  @map("actor_role")
  service       String   @db.VarChar(100)
  module        String   @db.VarChar(100)
  action        String   @db.VarChar(100)
  resource      String   @db.VarChar(100)
  resourceId    String?  @map("resource_id")
  beforeState   Json?    @map("before_state")
  afterState    Json?    @map("after_state")
  changedFields Json?    @map("changed_fields")
  requestId     String?  @map("request_id")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  storeId       String?  @map("store_id")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([service, module, createdAt])
  @@index([resource, resourceId])
  @@index([storeId, createdAt])
  @@map("audit_logs")
}
