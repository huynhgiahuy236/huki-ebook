// Business Service - Prisma Schema
// Database: business_db

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("BUSINESS_DATABASE_URL")
}

model Business {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  phone        String?
  address      String?
  taxCode      String?        @unique @map("tax_code")
  businessType BusinessType   @default(INDIVIDUAL) @map("business_type")
  status       BusinessStatus @default(PENDING_APPROVAL)

  // Registry verification (Mock)
  registryNumber     String?   @map("registry_number")
  registryVerifiedAt DateTime? @map("registry_verified_at")

  // Bank KYC details
  bankName              String?   @map("bank_name")
  bankAccountNumber     String?   @map("bank_account_number")
  bankAccountHolderName String?   @map("bank_account_holder_name")
  bankBranch            String?   @map("bank_branch")

  // Admin approval
  approvedAt      DateTime? @map("approved_at")
  approvedBy      String?   @map("approved_by")
  rejectedAt      DateTime? @map("rejected_at")
  rejectedBy      String?   @map("rejected_by")
  rejectionReason String?   @map("rejection_reason")

  // Owner ID (reference to identity_db)
  ownerId String @map("owner_id")

  // Relations
  stores         Store[]
  members        Member[]
  followers      BusinessFollower[]
  updateRequests BusinessUpdateRequest[]

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([ownerId])
  @@index([status])
  @@map("businesses")
}

model BusinessFollower {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
  @@map("business_followers")
}

enum BusinessType {
  INDIVIDUAL
  PARTNERSHIP
  CORPORATION
  LLC
}

enum BusinessStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

model Store {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String?
  logo        String?
  banner      String?
  email       String
  phone       String?
  address     String?
  status      StoreStatus @default(PENDING_APPROVAL)
  isActive    Boolean     @default(true) @map("is_active")
  categoryIds String[]    @map("category_ids")

  // Business reference
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Stats
  totalProducts Int   @default(0) @map("total_products")
  totalOrders   Int   @default(0) @map("total_orders")
  rating        Float @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([businessId])
  @@index([status])
  @@index([slug])
  @@map("stores")
}

enum StoreStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  CLOSED
}

model Member {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // User ID (reference to identity_db)
  userId String @map("user_id")

  role        MemberRole   @default(CONTENT_STAFF)
  status      MemberStatus @default(PENDING_INVITATION)
  invitedAt   DateTime?    @map("invited_at")
  invitedBy   String?      @map("invited_by")
  acceptedAt  DateTime?    @map("accepted_at")
  permissions Json?        @default("[]")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("members")
}

enum MemberRole {
  OWNER
  MANAGER
  ORDER_STAFF
  CONTENT_STAFF
  FINANCE_STAFF
}

enum MemberStatus {
  PENDING_INVITATION
  INVITATION_EXPIRED
  ACTIVE
  SUSPENDED
}

model Invitation {
  id         String           @id @default(uuid())
  email      String
  token      String           @unique @default(uuid())
  businessId String           @map("business_id")
  invitedBy  String           @map("invited_by")
  role       MemberRole       @default(CONTENT_STAFF)
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at")
  acceptedAt DateTime?        @map("accepted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([token])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// ============================================
// OUTBOX (Event Sourcing)
// ============================================

model OutboxEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique @map("event_id")
  type        String
  aggregateId String    @map("aggregate_id")
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

// ============================================
// BUSINESS PROFILE UPDATE REQUESTS
// ============================================

model BusinessUpdateRequest {
  id              String               @id @default(uuid())
  businessId      String               @map("business_id")
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedBy     String               @map("requested_by")
  requestedData   Json                 @map("requested_data")
  status          UpdateRequestStatus  @default(PENDING)
  rejectionReason String?              @map("rejection_reason")
  reviewedBy      String?              @map("reviewed_by")
  reviewedAt      DateTime?            @map("reviewed_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([status])
  @@map("business_update_requests")
}

enum UpdateRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// GOVERNANCE AUDIT LOGS (Phase 1)
// ============================================

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String   @map("actor_id")
  actorRole     String?  @map("actor_role")
  service       String   @db.VarChar(100)
  module        String   @db.VarChar(100)
  action        String   @db.VarChar(100)
  resource      String   @db.VarChar(100)
  resourceId    String?  @map("resource_id")
  beforeState   Json?    @map("before_state")
  afterState    Json?    @map("after_state")
  changedFields Json?    @map("changed_fields")
  requestId     String?  @map("request_id")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  storeId       String?  @map("store_id")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([service, module, createdAt])
  @@index([resource, resourceId])
  @@index([storeId, createdAt])
  @@map("audit_logs")
}


// ============================================
// BROADCAST NOTIFICATIONS (Phase 2 Migration)
// ============================================

enum NotificationCategory {
  MAINTENANCE
  POLICY
  ORDER
  FINANCE
  MARKETING
  SECURITY
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationTargetType {
  ALL
  SEGMENT
  DIRECT
}

enum NotificationStatus {
  ACTIVE
  SCHEDULED
  COMPLETED
  CANCELLED
}

model BroadcastNotification {
  id                     String                 @id @default(uuid())
  title                  String
  summary                String
  content                String                 @db.Text
  category               NotificationCategory   @default(POLICY)
  severity               NotificationSeverity   @default(INFO)
  targetType             NotificationTargetType @default(ALL)
  targetSegment          String?                @map("target_segment")
  targetRoles            String[]               @default(["ALL"]) @map("target_roles")
  targetBusinessIds      String[]               @default([]) @map("target_business_ids")
  channels               String[]               @default(["BELL"])
  isPinnedTop            Boolean                @default(false) @map("is_pinned_top")
  isDismissible          Boolean                @default(true) @map("is_dismissible")
  scheduleType           String                 @default("INSTANT") @map("schedule_type")
  recurringRule          String?                @map("recurring_rule")
  status                 NotificationStatus     @default(ACTIVE)
  authorName             String                 @default("Ban Quản Trị HUKI") @map("author_name")
  actionUrl              String?                @map("action_url")
  actionLabel            String?                @map("action_label")
  metadata               Json?
  scheduledAt            DateTime?              @map("scheduled_at")
  publishedAt            DateTime?              @map("published_at")
  expiresAt              DateTime?              @map("expires_at")
  createdById            String?                @map("created_by_id")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  receipts               BroadcastReceipt[]

  @@index([status, createdAt])
  @@index([category])
  @@map("broadcast_notifications")
}

model BroadcastReceipt {
  id              String                @id @default(uuid())
  notificationId  String                @map("notification_id")
  businessId      String                @map("business_id")
  isRead          Boolean               @default(false) @map("is_read")
  readAt          DateTime?             @map("read_at")
  isDismissed     Boolean               @default(false) @map("is_dismissed")
  dismissedAt     DateTime?             @map("dismissed_at")
  createdAt       DateTime              @default(now()) @map("created_at")

  notification    BroadcastNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, businessId])
  @@index([businessId, isRead])
  @@map("broadcast_receipts")
}

// ============================================
// SELLER FEATURE FLAGS (Phase 2 Migration)
// ============================================

enum FeatureCategory {
  marketing
  finance
  inventory
  customer
  operations
}

model SellerFeature {
  id                  String                  @id
  name                String
  category            FeatureCategory
  description         String                  @db.Text
  isEnabledGlobally   Boolean                 @default(true) @map("is_enabled_globally")
  maintenanceReason   String?                 @default("") @map("maintenance_reason")
  disabledBusinesses  String[]                @default([]) @map("disabled_businesses")
  enabledBusinesses   String[]                @default([]) @map("enabled_businesses")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  updatedBy           String                  @default("Admin System") @map("updated_by")

  overrides           SellerFeatureOverride[]

  @@map("seller_features")
}

model SellerFeatureOverride {
  id            String        @id @default(uuid())
  featureId     String        @map("feature_id")
  businessId    String        @map("business_id")
  isEnabled     Boolean       @map("is_enabled")
  reason        String?
  updatedAt     DateTime      @updatedAt @map("updated_at")
  updatedBy     String?       @map("updated_by")

  feature       SellerFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, businessId])
  @@index([businessId])
  @@map("seller_feature_overrides")
}

// ============================================
// SELLER PENALTIES & SANCTIONS (Phase 2 Migration)
// ============================================

enum PenaltyTier {
  TIER_0_GOOD
  TIER_1_WARNING
  TIER_2_RESTRICTED
  TIER_3_CRITICAL
  TIER_4_SUSPENDED
}

enum PenaltyAppealStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model StorePenaltyProfile {
  id                        String          @id @default(uuid())
  storeId                   String          @unique @map("store_id")
  storeName                 String?         @map("store_name")
  totalPoints               Int             @default(0) @map("total_points")
  penaltyPoints             Int             @default(0) @map("penalty_points")
  tier                      PenaltyTier     @default(TIER_0_GOOD)
  tierLabel                 String          @default("🟢 Hạng Tốt (Uy Tín)") @map("tier_label")
  tierDescription           String?         @map("tier_description")
  badgeColor                String          @default("emerald") @map("badge_color")
  canJoinPlatformFlashSale  Boolean         @default(true) @map("can_join_platform_flash_sale")
  maxBooksPerPlatformSlot   Int             @default(20) @map("max_books_per_platform_slot")
  activeSanctionMessage     String?         @map("active_sanction_message")
  sanctionExpiresAt         DateTime?       @map("sanction_expires_at")
  quarterlyResetDate        DateTime?       @map("quarterly_reset_date")
  quarterCycle              String          @default("Q4-2026") @map("quarter_cycle")
  nonFulfillmentRate        Float           @default(0.0) @map("non_fulfillment_rate")
  lateShipmentRate          Float           @default(0.0) @map("late_shipment_rate")
  responseRate              Float           @default(100.0) @map("response_rate")
  rating                    Float           @default(5.0)
  checklist                 Json?           @default("[]")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  records                   PenaltyRecord[]

  @@map("store_penalty_profiles")
}

model PenaltyRecord {
  id                String               @id @default(uuid())
  profileId         String               @map("profile_id")
  storeId           String               @map("store_id")
  violationType     String               @map("violation_type")
  violationName     String               @map("violation_name")
  points            Int                  @default(0)
  reason            String               @db.Text
  relatedOrderId    String?              @map("related_order_id")
  relatedBookTitle  String?              @map("related_book_title")
  expiresAt         DateTime             @map("expires_at")
  createdAt         DateTime             @default(now()) @map("created_at")

  isAppealed        Boolean              @default(false) @map("is_appealed")
  appealStatus      PenaltyAppealStatus  @default(NONE) @map("appeal_status")
  appealReason      String?              @map("appeal_reason") @db.Text
  appealProof       String?              @map("appeal_proof")
  appealAdminNote   String?              @map("appeal_admin_note") @db.Text
  appealReviewedAt  DateTime?            @map("appeal_reviewed_at")

  profile           StorePenaltyProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([violationType])
  @@map("penalty_records")
}
