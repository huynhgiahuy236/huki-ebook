# ============================================
# Business Service Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# ============================================
# SERVICE CONFIG
# ============================================
BUSINESS_SERVICE_PORT=3002
NODE_ENV=development

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
DATABASE_NAME=huki_business
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/business_db?schema=public

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=change-this-to-a-very-long-random-string-in-production

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3100

# ============================================
# REDIS (Caching)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# IDENTITY SERVICE (Internal API)
# ============================================
IDENTITY_SERVICE_URL=http://localhost:3001
INTERNAL_SERVICE_KEY=replace-with-the-same-long-random-internal-key-used-by-identity

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
