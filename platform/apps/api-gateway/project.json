{
  "name": "api-gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api-gateway/src",
  "projectType": "application",
  "implicitDependencies": ["shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/api-gateway/tsconfig.app.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/apps/api-gateway"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/api-gateway/main.js",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config apps/api-gateway/jest.config.js",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
