// Commerce Service - Prisma Schema
// Database: commerce_db

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("COMMERCE_DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum BookFormat {
  PHYSICAL
  DIGITAL
  BOTH
}

enum BookStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  SUSPENDED
  ARCHIVED
}

enum CartItemFormat {
  PHYSICAL
  DIGITAL
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  PROCESSING
  SHIPPING
  COMPLETED
  CANCELLED
  PARTIALLY_CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  ONLINE_PAYMENT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  PARTIAL_REFUND
  REFUND_FAILED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SellerOrderStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum AccessStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum BookAccessType {
  // FREE: Sách thường, mua 1 lần đọc mãi mãi
  FREE
  // PREMIUM: Sách premium, cần subscription hoặc trả thêm phí
  PREMIUM
}

enum SubscriptionTier {
  BASIC
  STANDARD
  PREMIUM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

// ============================================
// CATALOG
// ============================================

model Category {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @map("normalized_name")
  slug           String   @unique
  description    String?
  parentId       String?  @map("parent_id")
  image          String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  books    Book[]

  @@unique([parentId, normalizedName])
  @@map("categories")
}

model Author {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique @map("normalized_name")
  slug           String   @unique
  bio            String?
  avatar         String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  books Book[]

  @@map("authors")
}

model Publisher {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique @map("normalized_name")
  slug           String   @unique
  description    String?
  logo           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  books Book[]

  @@map("publishers")
}

// ============================================
// BOOKS
// ============================================

model Book {
  id              String     @id @default(uuid())
  storeId         String     @map("store_id")
  ownerUserId     String     @map("owner_user_id")
  title           String
  slug            String
  normalizedTitle String     @map("normalized_title")
  isbn            String?
  description     String
  price           Decimal    @db.Decimal(12, 2)
  categoryId      String?    @map("category_id")
  authorId        String?    @map("author_id")
  publisherId     String?    @map("publisher_id")
  format          BookFormat @default(PHYSICAL)
  coverUrl        String?    @map("cover_url")
  coverPublicId   String?    @map("cover_public_id")
  status          BookStatus @default(DRAFT)
  publishedAt     DateTime?  @map("published_at")
  viewCount       Int        @default(0) @map("view_count")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  category        Category?            @relation(fields: [categoryId], references: [id])
  author          Author?              @relation(fields: [authorId], references: [id])
  publisher       Publisher?           @relation(fields: [publisherId], references: [id])
  physicalDetails PhysicalBookDetails?
  digitalDetails  DigitalBookDetails?
  cartItems       CartItem[]
  orderItems      OrderItem[]
  bookAccesses    BookAccess[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([ownerUserId])
  @@index([categoryId])
  @@index([authorId])
  @@index([publisherId])
  @@index([status, price])
  @@map("books")
}

model PhysicalBookDetails {
  id              String   @id @default(uuid())
  bookId          String   @unique @map("book_id")
  stock           Int      @default(0)
  reserved        Int      @default(0)
  weight          Float? // grams
  dimensions      String?
  pageCount       Int?     @map("page_count")
  physicalEnabled Boolean  @default(true) @map("physical_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  book          Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  inventoryLogs InventoryLog[]

  @@map("physical_book_details")
}

model DigitalBookDetails {
  id             String   @id @default(uuid())
  bookId         String   @unique @map("book_id")
  pdfKey         String?  @map("pdf_key")
  epubKey        String?  @map("epub_key")
  previewPdfKey  String?  @map("preview_pdf_key")
  digitalEnabled Boolean  @default(true) @map("digital_enabled")
  accessType     BookAccessType @default(FREE) @map("access_type")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("digital_book_details")
}

// ============================================
// CART
// ============================================

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String         @map("cart_id")
  bookId    String         @map("book_id")
  format    CartItemFormat
  quantity  Int            @default(1)
  unitPrice Decimal        @db.Decimal(12, 2)
  addedAt   DateTime       @default(now()) @map("added_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id])

  @@unique([cartId, bookId])
  @@map("cart_items")
}

// ============================================
// CHECKOUT
// ============================================

model CheckoutSession {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  cartId        String    @map("cart_id")
  cartUpdatedAt DateTime  @map("cart_updated_at")
  snapshot      Json
  expiresAt     DateTime
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("checkout_sessions")
}

// ============================================
// ORDERS
// ============================================

model Order {
  id              String        @id @default(uuid())
  code            String        @unique
  userId          String        @map("user_id")
  idempotencyKey  String        @map("idempotency_key")
  itemSubtotal    Decimal       @map("item_subtotal") @db.Decimal(14, 2)
  shippingTotal   Decimal       @map("shipping_total") @db.Decimal(14, 2)
  discountTotal   Decimal       @default(0) @map("discount_total") @db.Decimal(14, 2)
  grandTotal      Decimal       @map("grand_total") @db.Decimal(14, 2)
  paymentMethod   PaymentMethod @map("payment_method")
  paymentProvider String?       @map("payment_provider")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  status          OrderStatus   @default(PENDING)
  shippingAddress Json?         @map("shipping_address")
  note            String?
  cancelledAt     DateTime?     @map("cancelled_at")
  cancelReason    String?       @map("cancel_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  sellerOrders  SellerOrder[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  refunds       Refund[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("orders")
}

model SellerOrder {
  id               String            @id @default(uuid())
  orderId          String            @map("order_id")
  code             String            @unique
  storeId          String            @map("store_id")
  ownerUserId      String            @map("owner_user_id")
  requiresShipping Boolean           @default(true) @map("requires_shipping")
  itemSubtotal     Decimal           @map("item_subtotal") @db.Decimal(14, 2)
  shippingFee      Decimal           @default(0) @map("shipping_fee") @db.Decimal(14, 2)
  grandTotal       Decimal           @map("grand_total") @db.Decimal(14, 2)
  status           SellerOrderStatus @default(PENDING_PAYMENT)
  carrier          String?
  trackingCode     String?           @map("tracking_code")
  confirmedAt      DateTime?         @map("confirmed_at")
  shippedAt        DateTime?         @map("shipped_at")
  completedAt      DateTime?         @map("completed_at")
  cancelledAt      DateTime?         @map("cancelled_at")
  cancelReason     String?           @map("cancel_reason")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  order Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([orderId])
  @@index([storeId])
  @@map("seller_orders")
}

model OrderItem {
  id            String   @id @default(uuid())
  sellerOrderId String   @map("seller_order_id")
  bookId        String   @map("book_id")
  bookTitle     String   @map("book_title")
  bookCoverUrl  String?  @map("book_cover_url")
  bookIsbn      String?  @map("book_isbn")
  format        String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  sellerOrder SellerOrder           @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  book        Book                  @relation(fields: [bookId], references: [id])
  reservation InventoryReservation?

  @@map("order_items")
}

// ============================================
// INVENTORY
// ============================================

model InventoryReservation {
  id          String            @id @default(uuid())
  orderId     String            @map("order_id")
  orderItemId String            @unique @map("order_item_id")
  bookId      String            @map("book_id")
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime?         @map("expires_at")
  committedAt DateTime?         @map("committed_at")
  releasedAt  DateTime?         @map("released_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderId, status])
  @@map("inventory_reservations")
}

model InventoryLog {
  id        String   @id @default(uuid())
  bookId    String   @map("book_id")
  change    Int // positive = add, negative = subtract
  balance   Int
  reason    String
  orderId   String?  @map("order_id")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  details PhysicalBookDetails @relation(fields: [bookId], references: [id])

  @@index([bookId, createdAt])
  @@map("inventory_logs")
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id                 String        @id @default(uuid())
  orderId            String        @map("order_id")
  amount             Decimal       @db.Decimal(14, 2)
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  provider           String?
  transactionId      String?       @map("transaction_id")
  payosOrderId       String?       @map("payos_order_id")
  payosPaymentLinkId String?       @map("payos_payment_link_id")
  payosReturnCode    String?       @map("payos_return_code")
  checkoutUrl        String?       @map("checkout_url")
  qrCode             String?       @map("qr_code")
  expiresAt          DateTime?     @map("expires_at")
  callbackData       Json?         @map("callback_data")
  paidAt             DateTime?     @map("paid_at")
  failedAt           DateTime?     @map("failed_at")
  failureReason      String?       @map("failure_reason")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([provider, payosOrderId])
  @@index([transactionId])
  @@index([orderId, status])
  @@map("payments")
}

model Refund {
  id                String       @id @default(uuid())
  orderId           String       @map("order_id")
  paymentId         String       @map("payment_id")
  amount            Decimal      @db.Decimal(14, 2)
  reason            String
  status            RefundStatus @default(PENDING)
  provider          String
  providerReference String?      @map("provider_reference")
  requestedBy       String       @map("requested_by")
  processedAt       DateTime?    @map("processed_at")
  failedAt          DateTime?    @map("failed_at")
  failureReason     String?      @map("failure_reason")
  metadata          Json?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([paymentId])
  @@map("refunds")
}

// ============================================
// BOOK ACCESS (Digital Library)
// ============================================

model BookAccess {
  id                 String         @id @default(uuid())
  userId             String         @map("user_id")
  bookId             String         @map("book_id")
  orderId            String         @map("order_id")
  sellerOrderId      String?        @map("seller_order_id")
  accessType         BookAccessType @default(FREE) @map("access_type")
  accessKey          String?        @map("access_key")
  signedUrlExpiresAt DateTime?      @map("signed_url_expires_at")
  readingProgress     Int            @default(0) @map("reading_progress")
  lastReadAt         DateTime?      @map("last_read_at")
  status             AccessStatus   @default(ACTIVE)
  downloadCount      Int            @default(0) @map("download_count")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("book_accesses")
}

// ============================================
// SUBSCRIPTION (SaaS Model)
// ============================================

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique @map("user_id")
  tier                 SubscriptionTier   @default(BASIC) @map("tier")
  status               SubscriptionStatus @default(ACTIVE) @map("status")

  // Billing
  billingCycle         String             @default("MONTHLY") @map("billing_cycle")
  price                Decimal            @db.Decimal(12, 2)

  // Dates
  startedAt            DateTime          @default(now()) @map("started_at")
  currentPeriodStart  DateTime          @default(now()) @map("current_period_start")
  currentPeriodEnd    DateTime          @map("current_period_end")
  cancelledAt          DateTime?         @map("cancelled_at")
  expiresAt           DateTime?         @map("expires_at")

  // Limits
  maxBooksPerPeriod   Int?               @map("max_books_per_period")

  // Auto-renew
  autoRenew            Boolean           @default(true) @map("auto_renew")

  // Payment
  paymentMethod        String?           @map("payment_method")
  lastPaymentAt       DateTime?         @map("last_payment_at")
  nextPaymentAt       DateTime?         @map("next_payment_at")

  // Usage tracking
  booksReadThisPeriod Int               @default(0) @map("books_read_this_period")

  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  accessLogs          SubscriptionAccessLog[]

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionAccessLog {
  id               String         @id @default(uuid())
  subscriptionId  String         @map("subscription_id")
  userId           String         @map("user_id")
  bookId           String         @map("book_id")
  accessType       BookAccessType @default(FREE) @map("access_type")
  accessedAt       DateTime       @default(now()) @map("accessed_at")

  subscription     Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([userId])
  @@index([accessedAt])
  @@map("subscription_access_logs")
}

// ============================================
// STATUS HISTORY
// ============================================

model OrderStatusHistory {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  sellerOrderId String?  @map("seller_order_id")
  fromStatus    String?  @map("from_status")
  toStatus      String   @map("to_status")
  title         String
  description   String?
  actorType     String   @map("actor_type")
  actorId       String?  @map("actor_id")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

// ============================================
// OUTBOX (Event Sourcing)
// ============================================

model OutboxEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique @map("event_id")
  type        String
  aggregateId String    @map("aggregate_id")
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model InboxEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  type        String
  aggregateId String   @map("aggregate_id")
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([type, processedAt])
  @@map("inbox_events")
}
